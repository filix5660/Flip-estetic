# Copia este ficheiro para `.env.local` e preenche os valores.
# O `.env.local` NUNCA vai para o GitHub (está no .gitignore).
#
# Sem estas variáveis, a aplicação corre em modo de demonstração.

# Painel do Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Painel do Supabase → Project Settings → API Keys → chave "publishable"
# (começa por sb_publishable_; em projetos antigos chama-se "anon").
#
# ATENÇÃO: NUNCA colocar aqui a chave "secret" / "service_role".
# Essa chave ignora todas as regras de segurança, e tudo o que começa por
# NEXT_PUBLIC_ é enviado para o navegador de quem visita o site.
# Esta aplicação não precisa da chave secreta para nada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (usado nos links dos emails de confirmação).
# Em desenvolvimento: http://localhost:3000
# Em produção: o endereço real, com https://
NEXT_PUBLIC_SITE_URL=http://localhost:3000
